// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model CharacterDefinition {
  key           String                @id
  rarity        Int //@default(0)
  element       String
  weaponTypeKey String
  nation        String
  weaponType    WeaponType            @relation(fields: [weaponTypeKey], references: [key])
  characters    Character[]
  buildGuides   BuildGuideCharacter[]

  materials CharacterMaterial?
}

model Character {
  id                  Int                 @id @default(autoincrement())
  definitionKey       String
  userId              Int
  level               Int
  constellation       Int
  friendship          Int
  ascension           Int
  normalAttackLevel   Int
  elementalSkillLevel Int
  elementalBurstLevel Int
  isPreferred Boolean @default(false)
  definition          CharacterDefinition @relation(fields: [definitionKey], references: [key])
  loadouts            Loadout[]
  user                User                @relation(fields: [userId], references: [id])
}

model WeaponDefinition {
  key            String             @id
  rarity         Int
  baseATK        Int
  subStatTypeKey String? //@default("atk-p")
  subStat        Float?
  weaponTypeKey  String
  weaponType     WeaponType         @relation(fields: [weaponTypeKey], references: [key])
  subStatType    StatType?           @relation(fields: [subStatTypeKey], references: [key])
  obtainType     String
  weapons        Weapon[]
  buildGuides    BuildGuideWeapon[]
  materials WeaponMaterial?
}

model Weapon {
  id            Int              @id @default(autoincrement())
  definitionKey String
  level         Int
  refinement    Int
  definition    WeaponDefinition @relation(fields: [definitionKey], references: [key])
  loadouts      Loadout[]
  userId        Int
  user          User             @relation(fields: [userId], references: [id])
}

model ArtifactSetDefinition {
  key         String                  @id
  artifacts   Artifact[]
  buildGuides BuildGuideArtifactSet[]
}

model Artifact {
  id               Int                   @id @default(autoincrement())
  setKey           String
  slotKey          String
  level            Int
  artifactSet      ArtifactSetDefinition @relation(fields: [setKey], references: [key])
  slot             ArtifactSlot          @relation(fields: [slotKey], references: [key])
  mainStatTypeKey  String
  mainStatValue    Float
  mainStat         StatType              @relation(fields: [mainStatTypeKey], references: [key])
  subStats         ArtifactSubStat[]
  artifactLoadouts ArtifactLoadoutItem[]
  userId           Int
  user             User                  @relation(fields: [userId], references: [id])
}

model ArtifactSubStat {
  id          Int      @id @default(autoincrement())
  artifactId  Int
  statTypeKey String
  value       Float
  artifact    Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  statType    StatType @relation(fields: [statTypeKey], references: [key])
}

model Translation {
  id         Int    @id @default(autoincrement())
  entityType String
  key        String
  language   String
  field      String
  text       String

  @@unique([entityType, key, language, field])
}

model WeaponType {
  key        String                @id
  characters CharacterDefinition[]
  weapon     WeaponDefinition[]
}

model ArtifactSlot {
  key                 String               @id
  artifacts           Artifact[]
  buildGuideMainStats BuildGuideMainStat[]
}

model StatType {
  key                  String                   @id
  weapons              WeaponDefinition[]
  artifacts            Artifact[]
  subStats             ArtifactSubStat[]
  buildGuideMainStats  BuildGuideMainStat[]
  buildGuidePriorities BuildGuideStatPriority[]
}

model BuildGuide {
  id             Int                      @id @default(autoincrement())
  name           String
  description    String?
  characters     BuildGuideCharacter[]
  weapons        BuildGuideWeapon[]
  artifactSets   BuildGuideArtifactSet[]
  mainStats      BuildGuideMainStat[]
  statPriorities BuildGuideStatPriority[]
  loadoutLinks   LoadoutBuildGuide[]
  userId         Int
  user           User                     @relation(fields: [userId], references: [id])
}

model BuildGuideCharacter {
  buildGuideId           Int
  characterDefinitionKey String
  buildGuide             BuildGuide          @relation(fields: [buildGuideId], references: [id], onDelete: Cascade)
  character              CharacterDefinition @relation(fields: [characterDefinitionKey], references: [key], onDelete: Cascade)

  @@id([buildGuideId, characterDefinitionKey])
}

model BuildGuideWeapon {
  buildGuideId Int
  weaponKey    String
  buildGuide   BuildGuide       @relation(fields: [buildGuideId], references: [id], onDelete: Cascade)
  weapon       WeaponDefinition @relation(fields: [weaponKey], references: [key], onDelete: Cascade)

  @@id([buildGuideId, weaponKey])
}

model BuildGuideArtifactSet {
  buildGuideId   Int
  artifactSetKey String
  pieces         Int
  buildGuide     BuildGuide            @relation(fields: [buildGuideId], references: [id], onDelete: Cascade)
  artifactSet    ArtifactSetDefinition @relation(fields: [artifactSetKey], references: [key], onDelete: Cascade)

  @@id([buildGuideId, artifactSetKey, pieces])
}

model BuildGuideMainStat {
  buildGuideId Int
  slotKey      String
  statTypeKey  String
  buildGuide   BuildGuide   @relation(fields: [buildGuideId], references: [id], onDelete: Cascade)
  slot         ArtifactSlot @relation(fields: [slotKey], references: [key], onDelete: Cascade)
  statType     StatType     @relation(fields: [statTypeKey], references: [key], onDelete: Cascade)

  @@id([buildGuideId, slotKey, statTypeKey])
}

model BuildGuideStatPriority {
  id           Int        @id @default(autoincrement())
  buildGuideId Int
  statTypeKey  String
  priority     Int
  targetValue  Float?
  buildGuide   BuildGuide @relation(fields: [buildGuideId], references: [id], onDelete: Cascade)
  statType     StatType   @relation(fields: [statTypeKey], references: [key], onDelete: Cascade)

  @@unique([buildGuideId, priority])
}

model ArtifactLoadout {
  id          Int                   @id @default(autoincrement())
  name        String
  description String?
  artifacts   ArtifactLoadoutItem[]
  loadouts    Loadout[]
  userId      Int
  user        User                  @relation(fields: [userId], references: [id])
}

model ArtifactLoadoutItem {
  artifactLoadoutId Int
  artifactId        Int
  artifactLoadout   ArtifactLoadout @relation(fields: [artifactLoadoutId], references: [id], onDelete: Cascade)
  artifact          Artifact        @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@id([artifactLoadoutId, artifactId])
}

model Loadout {
  id                Int     @id @default(autoincrement())
  name              String
  description       String?
  characterId       Int
  weaponId          Int?
  artifactLoadoutId Int?

  character       Character           @relation(fields: [characterId], references: [id], onDelete: Cascade)
  weapon          Weapon?             @relation(fields: [weaponId], references: [id], onDelete: SetNull)
  artifactLoadout ArtifactLoadout?    @relation(fields: [artifactLoadoutId], references: [id], onDelete: SetNull)
  buildGuides     LoadoutBuildGuide[]

  targetLevel               Int?
  targetAscension           Int?
  targetNormalAttackLevel   Int?
  targetElementalSkillLevel Int?
  targetElementalBurstLevel Int?
  targetWeaponLevel         Int?

  showInHome Boolean @default(false)
  isPreferred Boolean @default(false)
  userId Int
  user   User @relation(fields: [userId], references: [id])
}

model LoadoutBuildGuide {
  loadoutId    Int
  buildGuideId Int
  loadout      Loadout    @relation(fields: [loadoutId], references: [id], onDelete: Cascade)
  buildGuide   BuildGuide @relation(fields: [buildGuideId], references: [id], onDelete: Cascade)

  @@id([loadoutId, buildGuideId])
}

model User {
  id               Int               @id @default(autoincrement())
  username         String            @unique
  characters       Character[]
  weapons          Weapon[]
  artifacts        Artifact[]
  artifactLoadouts ArtifactLoadout[]
  buildGuides      BuildGuide[]
  loadouts         Loadout[]
}

model MaterialDefinition {
  key     String           @id
  type    MaterialType
  sources MaterialSource[]

  characterMaterialBoss       CharacterMaterial[] @relation("CharacterBossMaterial")
  characterMaterialSpecialty  CharacterMaterial[] @relation("CharacterRegionalSpecialty")
  characterMaterialCommon     CharacterMaterial[] @relation("CharacterCommonMaterial")
  characterMaterialTalent     CharacterMaterial[] @relation("CharacterTalentMaterial")
  characterMaterialWeeklyBoss CharacterMaterial[] @relation("CharacterWeeklyBossMaterial")

  weaponMaterialDomain  WeaponMaterial[] @relation("WeaponDomainMaterial")
  weaponMaterialCommon1 WeaponMaterial[] @relation("WeaponCommonMaterial1")
  weaponMaterialCommon2 WeaponMaterial[] @relation("WeaponCommonMaterial2")
}

model CharacterMaterial {
  characterDefinitionKey String @id

  bossMaterialKey       String
  regionalSpecialtyKey  String
  commonMaterialKey     String
  talentMaterialKey     String
  weeklyBossMaterialKey String

  characterDefinition CharacterDefinition @relation(fields: [characterDefinitionKey], references: [key], onDelete: Cascade)
  bossMaterial        MaterialDefinition  @relation("CharacterBossMaterial", fields: [bossMaterialKey], references: [key])
  regionalSpecialty   MaterialDefinition  @relation("CharacterRegionalSpecialty", fields: [regionalSpecialtyKey], references: [key])
  commonMaterial      MaterialDefinition  @relation("CharacterCommonMaterial", fields: [commonMaterialKey], references: [key])
  talentMaterial      MaterialDefinition  @relation("CharacterTalentMaterial", fields: [talentMaterialKey], references: [key])
  weeklyBossMaterial  MaterialDefinition  @relation("CharacterWeeklyBossMaterial", fields: [weeklyBossMaterialKey], references: [key])
}

model WeaponMaterial {
  weaponDefinitionKey String @id
  domainMaterialKey   String
  commonMaterial1Key  String
  commonMaterial2Key  String

  weaponDefinition WeaponDefinition   @relation(fields: [weaponDefinitionKey], references: [key], onDelete: Cascade)
  domainMaterial   MaterialDefinition @relation("WeaponDomainMaterial", fields: [domainMaterialKey], references: [key])
  commonMaterial1  MaterialDefinition @relation("WeaponCommonMaterial1", fields: [commonMaterial1Key], references: [key])
  commonMaterial2  MaterialDefinition @relation("WeaponCommonMaterial2", fields: [commonMaterial2Key], references: [key])
}

model AscensionRequirement {
  id        Int @id @default(autoincrement())
  ascension Int @unique

  gemQuantity Int
  gemQuality  Int

  bossQuantity      Int
  specialtyQuantity Int

  matQuantity Int
  matQuality  Int
}

model TalentRequirement {
  id          Int @id @default(autoincrement())
  talentLevel Int @unique

  domainQuantity Int
  domainQuality  Int

  matQuantity Int
  matQuality  Int

  weeklyBossQuantity Int
}

model WeaponLevelRequirement {
  id           Int @id @default(autoincrement())
  weaponRarity Int
  ascension    Int

  domainQuantity Int
  domainQuality  Int

  mat1Quantity Int
  mat1Quality  Int

  mat2Quantity Int
  mat2Quality  Int

  @@unique([weaponRarity, ascension])
}

model MaterialSource {
  id          Int                @id @default(autoincrement())
  domainName  String
  type        MaterialSourceType
  days        MaterialSourceDays
  materialKey String

  material MaterialDefinition @relation(fields: [materialKey], references: [key])

  @@unique([domainName, materialKey])
}

enum MaterialSourceType {
  TALENT_MATERIAL
  WEAPON_MATERIAL
}

enum MaterialSourceDays {
  MONDAY_THURSDAY_SUNDAY
  TUESDAY_FRIDAY_SUNDAY
  WEDNESDAY_SATURDAY_SUNDAY
}

enum MaterialType {
  ASCENSION_GEM
  BOSS_MATERIAL
  WEEKLY_BOSS_MATERIAL
  REGIONAL_SPECIALTY
  TALENT_MATERIAL
  GREEN_COMMON_ENEMY_DROP
  WHITE_COMMON_ENEMY_DROP
  WEAPON_MATERIAL
  CURRENCY
  OTHER
}
