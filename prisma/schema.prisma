// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model CharacterDefinition {
  key          String                 @id
  translations CharacterTranslation[]
}

model CharacterTranslation {
  id            Int                 @id @default(autoincrement())
  characterKey  String
  language      String
  displayName   String

  character     CharacterDefinition @relation(fields: [characterKey], references: [key], onDelete: Cascade)

  @@unique([characterKey, language])
}