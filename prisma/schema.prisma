// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model CharacterDefinition {
  key           String                @id
  rarity        Int //@default(0)
  element       String
  weaponTypeKey String
  nation        String
  weaponType    WeaponType            @relation(fields: [weaponTypeKey], references: [key])
  characters    Character[]
  buildGuides   BuildGuideCharacter[]
}

model Character {
  id                  Int                 @id @default(autoincrement())
  definitionKey       String
  level               Int
  constellation       Int
  friendship          Int
  ascension           Int
  normalAttackLevel   Int
  elementalSkillLevel Int
  elementalBurstLevel Int
  definition          CharacterDefinition @relation(fields: [definitionKey], references: [key])
  loadouts            Loadout[]
}

model WeaponDefinition {
  key            String             @id
  rarity         Int
  baseATK        Int
  subStatTypeKey String //@default("atk-p")
  subStat        Float
  weaponTypeKey  String
  weaponType     WeaponType         @relation(fields: [weaponTypeKey], references: [key])
  subStatType    StatType           @relation(fields: [subStatTypeKey], references: [key])
  weapons        Weapon[]
  buildGuides    BuildGuideWeapon[]
}

model Weapon {
  id            Int              @id @default(autoincrement())
  definitionKey String
  level         Int
  refinement    Int
  definition    WeaponDefinition @relation(fields: [definitionKey], references: [key])
  loadouts      Loadout[]
}

model ArtifactSetDefinition {
  key         String                  @id
  artifacts   Artifact[]
  buildGuides BuildGuideArtifactSet[]
}

model Artifact {
  id             Int    @id @default(autoincrement())
  setKey         String
  slotKey        String
  level          Int
  artifactSet    ArtifactSetDefinition @relation(fields: [setKey], references: [key])
  slot           ArtifactSlot          @relation(fields: [slotKey], references: [key])
  mainStatTypeKey String
  mainStatValue   Float
  mainStat        StatType             @relation(fields: [mainStatTypeKey], references: [key])
  subStats        ArtifactSubStat[]
  artifactLoadouts ArtifactLoadoutItem[]
}

model ArtifactSubStat {
  id          Int      @id @default(autoincrement())
  artifactId  Int
  statTypeKey String
  value       Float
  artifact    Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  statType    StatType @relation(fields: [statTypeKey], references: [key])
}

model Translation {
  id         Int    @id @default(autoincrement())
  entityType String
  key        String
  language   String
  field      String
  text       String

  @@unique([entityType, key, language, field])
}

model WeaponType {
  key        String                @id
  characters CharacterDefinition[]
  weapon     WeaponDefinition[]
}

model ArtifactSlot {
  key                 String               @id
  artifacts           Artifact[]
  buildGuideMainStats BuildGuideMainStat[]
}

model StatType {
  key                  String                   @id
  weapons              WeaponDefinition[]
  artifacts            Artifact[]
  subStats             ArtifactSubStat[]
  buildGuideMainStats  BuildGuideMainStat[]
  buildGuidePriorities BuildGuideStatPriority[]
}

model BuildGuide {
  id             Int                      @id @default(autoincrement())
  name           String
  description    String?
  characters     BuildGuideCharacter[]
  weapons        BuildGuideWeapon[]
  artifactSets   BuildGuideArtifactSet[]
  mainStats      BuildGuideMainStat[]
  statPriorities BuildGuideStatPriority[]
  loadouts       Loadout[]
}

model BuildGuideCharacter {
  buildGuideId           Int
  characterDefinitionKey String
  buildGuide             BuildGuide          @relation(fields: [buildGuideId], references: [id], onDelete: Cascade)
  character              CharacterDefinition @relation(fields: [characterDefinitionKey], references: [key], onDelete: Cascade)

  @@id([buildGuideId, characterDefinitionKey])
}

model BuildGuideWeapon {
  buildGuideId Int
  weaponKey    String
  buildGuide   BuildGuide       @relation(fields: [buildGuideId], references: [id], onDelete: Cascade)
  weapon       WeaponDefinition @relation(fields: [weaponKey], references: [key], onDelete: Cascade)

  @@id([buildGuideId, weaponKey])
}

model BuildGuideArtifactSet {
  buildGuideId   Int
  artifactSetKey String
  pieces         Int
  buildGuide     BuildGuide            @relation(fields: [buildGuideId], references: [id], onDelete: Cascade)
  artifactSet    ArtifactSetDefinition @relation(fields: [artifactSetKey], references: [key], onDelete: Cascade)

  @@id([buildGuideId, artifactSetKey, pieces])
}

model BuildGuideMainStat {
  buildGuideId Int
  slotKey      String
  statTypeKey  String
  buildGuide   BuildGuide   @relation(fields: [buildGuideId], references: [id], onDelete: Cascade)
  slot         ArtifactSlot @relation(fields: [slotKey], references: [key], onDelete: Cascade)
  statType     StatType     @relation(fields: [statTypeKey], references: [key], onDelete: Cascade)

  @@id([buildGuideId, slotKey, statTypeKey])
}

model BuildGuideStatPriority {
  id           Int        @id @default(autoincrement())
  buildGuideId Int
  statTypeKey  String
  priority     Int
  targetValue  Float?
  buildGuide   BuildGuide @relation(fields: [buildGuideId], references: [id], onDelete: Cascade)
  statType     StatType   @relation(fields: [statTypeKey], references: [key], onDelete: Cascade)

  @@unique([buildGuideId, priority])
}

model ArtifactLoadout {
  id          Int                   @id @default(autoincrement())
  name        String
  description String?
  artifacts   ArtifactLoadoutItem[]
  loadouts    Loadout[]
}

model ArtifactLoadoutItem {
  artifactLoadoutId Int
  artifactId        Int
  artifactLoadout   ArtifactLoadout @relation(fields: [artifactLoadoutId], references: [id], onDelete: Cascade)
  artifact          Artifact        @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@id([artifactLoadoutId, artifactId])
}

model Loadout {
  id                Int              @id @default(autoincrement())
  name              String
  description       String?
  characterId       Int?
  weaponId          Int?
  artifactLoadoutId Int?
  buildGuideId      Int?
  character         Character?       @relation(fields: [characterId], references: [id], onDelete: SetNull)
  weapon            Weapon?          @relation(fields: [weaponId], references: [id], onDelete: SetNull)
  artifactLoadout   ArtifactLoadout? @relation(fields: [artifactLoadoutId], references: [id], onDelete: SetNull)
  buildGuide        BuildGuide?      @relation(fields: [buildGuideId], references: [id], onDelete: SetNull)
}
